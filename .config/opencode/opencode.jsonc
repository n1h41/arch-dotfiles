{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "agents": {
    "build": {
      "mode": "primary"
    },
    "plan": {
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "dart-mcp-server": {
        "type": "local",
        "command": ["dart", "mcp-server"],
        "disabled": false
      },
      "jira": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/sse",
        "disabled": true,
        "oauth": {
          "scope": "tools:read"
        }
      }
    }
  },
  "plugins": ["@tarquinen/opencode-dcp@latest"]
}
